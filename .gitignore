# Python
__pycache__/
*.pyc

# Raw FITS downloads: large (up to ~268MB/file), not needed for deployment,
# and would blow past GitHub's 100MB per-file push limit anyway.
allsky_textures/fits/

# Raw Gaia TAP catalog cache (see download_gaia_catalog.py): regenerable
# from the Gaia archive, not needed for deployment.
allsky_textures/gaia_catalog/

# Raw GWOSC skymap tars/FITS + manifest (see download_gw_skymaps.py):
# regenerable from GWOSC/Zenodo, not needed for deployment.
allsky_textures/gw_catalog/

# Raw ICECAT-1 catalog table (see download_icecube_catalog.py): regenerable
# from Harvard Dataverse, not needed for deployment.
allsky_textures/icecube_catalog/

# allsky_textures/png/ IS tracked - it's the data the deployed site serves,
# and each file is well under 100MB.

